generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
}

/// カードの種類（仕様書 §4.3.1）
enum CardKind {
  testimony
  item
}

enum ScenarioStatus {
  draft
  published
  hidden_by_author
  hidden_by_report
  hidden_by_admin
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash")
  displayName  String     @map("display_name")
  status       UserStatus @default(active)
  agreedAgeAt  DateTime   @map("agreed_age_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  scenarios      Scenario[]
  played         PlayedScenario[]
  participations Participation[]

  @@map("users")
}

model Scenario {
  id             String         @id @default(uuid()) @db.Uuid
  /// 運営制作シナリオの識別子（seedの冪等性に使う）。投稿シナリオはnull
  slug           String?        @unique
  authorId       String?        @map("author_id") @db.Uuid
  title          String
  summary        String
  introText      String         @map("intro_text")
  endingText     String         @map("ending_text")
  victimName     String?        @map("victim_name")
  victimProfile  String?        @map("victim_profile")
  status         ScenarioStatus @default(draft)
  /// 下書きの本文（入力途中のまま保存する）。公開時に検証して各列へ展開し、nullにする
  draft          Json?
  checkResult    Json?          @map("check_result")
  contentVersion Int            @default(1) @map("content_version")
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  author     User?            @relation(fields: [authorId], references: [id])
  characters Character[]
  games      Game[]
  played     PlayedScenario[]

  @@index([status, publishedAt])
  @@map("scenarios")
}

model Character {
  id            String  @id @default(uuid()) @db.Uuid
  scenarioId    String  @map("scenario_id") @db.Uuid
  slot          Int     @db.SmallInt
  name          String
  publicProfile String  @map("public_profile")
  situationText String  @map("situation_text")
  isCulprit     Boolean @default(false) @map("is_culprit")

  scenario       Scenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  cards          Card[]
  participations Participation[]

  @@unique([scenarioId, slot])
  @@map("characters")
}

model Card {
  id           String   @id @default(uuid()) @db.Uuid
  characterId  String   @map("character_id") @db.Uuid
  slot         Int      @db.SmallInt
  kind         CardKind
  title        String
  body         String
  /// 捏造カード。シナリオにつき1枚（アプリ層で保証）
  isFabricated Boolean  @default(false) @map("is_fabricated")

  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  revealed  RevealedCard[]

  @@unique([characterId, slot])
  @@map("cards")
}

/// プレイ済み管理（仕様書 §7.3）。ゲームの確認フェーズに入った時点で記録する
model PlayedScenario {
  userId        String   @map("user_id") @db.Uuid
  scenarioId    String   @map("scenario_id") @db.Uuid
  firstPlayedAt DateTime @default(now()) @map("first_played_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@id([userId, scenarioId])
  @@map("played_scenarios")
}

enum GameStatus {
  playing
  finished
  aborted
}

enum ParticipantKind {
  human
  npc
}

enum Outcome {
  win
  lose
  left
  npc
}

/// 1プレイ＝1ルーム。ルームIDとして使う
model Game {
  id              String     @id @default(uuid()) @db.Uuid
  scenarioId      String     @map("scenario_id") @db.Uuid
  scenarioVersion Int        @map("scenario_version")
  status          GameStatus @default(playing)
  result          Json?
  startedAt       DateTime   @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime?  @map("finished_at") @db.Timestamptz

  scenario       Scenario        @relation(fields: [scenarioId], references: [id])
  participations Participation[]
  chatMessages   ChatMessage[]
  revealedCards  RevealedCard[]
  votes          Vote[]

  @@index([status])
  @@map("games")
}

/// ゲームの席（4件／ゲーム）
model Participation {
  id              String          @id @default(uuid()) @db.Uuid
  gameId          String          @map("game_id") @db.Uuid
  seat            Int             @db.SmallInt
  characterId     String          @map("character_id") @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  initialKind     ParticipantKind @map("initial_kind")
  switchedToNpcAt DateTime?       @map("switched_to_npc_at") @db.Timestamptz
  outcome         Outcome?

  game      Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  character Character      @relation(fields: [characterId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
  chat      ChatMessage[]
  revealed  RevealedCard[]
  votesCast Vote[]         @relation("voter")
  votesGot  Vote[]         @relation("target")

  @@unique([gameId, seat])
  @@index([userId])
  @@map("participations")
}

model ChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  gameId          String   @map("game_id") @db.Uuid
  participationId String   @map("participation_id") @db.Uuid
  setNo           Int      @map("set_no") @db.SmallInt
  body            String
  createdAt       DateTime @map("created_at") @db.Timestamptz

  game          Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("chat_messages")
}

model RevealedCard {
  id              String  @id @default(uuid()) @db.Uuid
  gameId          String  @map("game_id") @db.Uuid
  participationId String  @map("participation_id") @db.Uuid
  cardId          String  @map("card_id") @db.Uuid
  setNo           Int     @map("set_no") @db.SmallInt
  autoSelected    Boolean @default(false) @map("auto_selected")

  game          Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  card          Card          @relation(fields: [cardId], references: [id])

  @@unique([gameId, cardId])
  @@map("revealed_cards")
}

model Vote {
  gameId   String  @map("game_id") @db.Uuid
  voterId  String  @map("voter_participation_id") @db.Uuid
  /// 棄権はnull
  targetId String? @map("target_participation_id") @db.Uuid

  game   Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  voter  Participation  @relation("voter", fields: [voterId], references: [id], onDelete: Cascade)
  target Participation? @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([gameId, voterId])
  @@map("votes")
}
