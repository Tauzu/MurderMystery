{
  "name": "murder-mystery-online",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "pnpm --filter @mm/server dev",
    "dev:web": "pnpm --filter @mm/web dev",
    "build:web": "pnpm --filter @mm/web build",
    "db:deploy": "pnpm --filter @mm/server db:deploy",
    "db:seed": "pnpm --filter @mm/server db:seed",
    "db:migrate": "pnpm --filter @mm/server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
